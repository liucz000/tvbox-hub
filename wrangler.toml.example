# 复制为本地配置后再修改：
#   cp wrangler.toml.example wrangler.toml
# wrangler.toml 含账号专属信息，已被 .gitignore 忽略，不要提交。
name = "tvbox-hub"
main = "src/worker.ts"
compatibility_date = "2026-01-01"

# 部署前执行：
#   npx wrangler kv namespace create KV
# 把输出的 id 填到下面（preview_id 可选，仅 wrangler dev 需要）
[[kv_namespaces]]
binding = "KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
# preview_id = "REPLACE_WITH_YOUR_PREVIEW_KV_ID"

# 每小时唤醒一次，由 REFRESH_INTERVAL_MINUTES 决定是否真正聚合
[triggers]
crons = ["15 * * * *"]

[vars]
REFRESH_INTERVAL_MINUTES = "720"
# off | shallow | deep；Worker 受子请求数量限制，默认关闭
PROBE = "off"
# 免费版单次调用 50 个子请求上限，建议 10；付费版可调大
MAX_SOURCES = "10"

# 自定义域名（可选）：域名需已托管在同一 Cloudflare 账号下
# routes = [
#   { pattern = "tvbox.example.com", custom_domain = true }
# ]

# ADMIN_PASSWORD / ADMIN_TOKEN 用 secret 写入，不要写在这里：
#   npx wrangler secret put ADMIN_PASSWORD
#   npx wrangler secret put ADMIN_TOKEN
